# Backend API origin, without the trailing /api.
# Leave empty in development to use the Vite proxy (/api and /socket.io -> localhost:4000).
VITE_API_URL=
# Socket.io origin. Leave empty to use the same origin as the app (Vite proxy in development).
VITE_WS_URL=

# Firebase Cloud Messaging (web push)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
