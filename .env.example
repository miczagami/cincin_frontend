# Backend API origin, without the trailing /api (production: https://api.playcincin.com).
# Leave empty in development to use the Vite proxy (/api and /socket.io -> localhost:4000).
# VITE_* values are baked in at build time — set them on the host as build variables.
VITE_API_URL=
# Socket.io origin (production: https://api.playcincin.com).
# Leave empty to use the same origin as the app (Vite proxy in development).
VITE_WS_URL=

# Firebase Cloud Messaging (web push). The app and its service worker (src/sw.js) both read these
# at build time; leave any of them empty and the build ships without push.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Where share actions (Palate Wrapped, season results) link to. Defaults to https://app.playcincin.com
VITE_SHARE_URL=
